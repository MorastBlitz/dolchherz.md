{
	"name": "dolchherz.md",
	"version": "0.1.0",
	"description": "Obsidian-Plugin für Gegner- und Schauplatz-Wertekästen in Daggerheart (deutsch)",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"pruefen": "node scripts/pruefe.mjs && node .pruefung.cjs"
	},
	"keywords": [
		"obsidian",
		"daggerheart",
		"ttrpg"
	],
	"license": "MIT",
	"dependencies": {
		"@airjp73/dice-notation": "^2.2.2"
	},
	"devDependencies": {
		"@types/node": "^24.0.0",
		"builtin-modules": "3.3.0",
		"esbuild": "0.17.3",
		"obsidian": "latest",
		"typescript": "^5.4.0"
	}
}
